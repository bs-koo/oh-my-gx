{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "exec_command|local_shell|shell",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT:-.}/.claude/hooks/pre-tool-guard.sh",
            "shell": "bash"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion|request_user_input",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT:-.}/.claude/hooks/capture-decision.sh",
            "shell": "bash"
          }
        ]
      }
    ]
  }
}
