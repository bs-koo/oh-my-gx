{
  "name": "oh-my-gx",
  "description": "gx-work 하나로 맥락·계획·TDD 개발·검증을 연결하는 개발 자동화 플러그인.",
  "version": "2.0.0",
  "author": {
    "name": "bs-koo"
  },
  "homepage": "https://github.com/bs-koo/oh-my-gx",
  "repository": "https://github.com/bs-koo/oh-my-gx",
  "keywords": [
    "java",
    "spring-boot",
    "vue",
    "fullstack",
    "korean",
    "dev-workflow",
    "prd",
    "code-review"
  ],
  "skills": "./.claude/skills/",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre-tool-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/.claude/hooks/capture-decision.sh"
          }
        ]
      }
    ]
  }
}
