{
  "name": "oh-my-gx",
  "description": "도메인 컨텍스트와 TDD를 기반으로 개발 전 과정을 연결하는 AI 워크플로 오케스트레이션 플러그인.",
  "version": "2.0.0",
  "author": {
    "name": "bs-koo"
  },
  "homepage": "https://bs-koo.github.io/oh-my-gx/",
  "repository": "https://github.com/bs-koo/oh-my-gx",
  "keywords": [
    "java",
    "spring-boot",
    "vue",
    "fullstack",
    "korean",
    "dev-workflow",
    "prd",
    "code-review",
    "ai-workflow",
    "tdd",
    "domain-context"
  ],
  "skills": "./.claude/skills/",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre-tool-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/.claude/hooks/capture-decision.sh"
          }
        ]
      }
    ]
  }
}
