{
  "name": "oh-my-gx",
  "description": "프로젝트 지식 관리와 설계·TDD·검증·PR을 지원합니다. v3.3.0에서 gx-cross-review를 읽기 전용 엣지케이스 조사 스킬(gx-edge-cases)로 교체했습니다.",
  "version": "3.3.0",
  "author": {
    "name": "bs-koo"
  },
  "homepage": "https://bs-koo.github.io/oh-my-gx/",
  "repository": "https://github.com/bs-koo/oh-my-gx",
  "keywords": [
    "java",
    "spring-boot",
    "vue",
    "fullstack",
    "korean",
    "dev-workflow",
    "prd",
    "code-review",
    "edge-cases",
    "ai-workflow",
    "tdd",
    "domain-context"
  ],
  "skills": "./.claude/skills/",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre-tool-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/.claude/hooks/capture-decision.sh"
          }
        ]
      }
    ]
  }
}
