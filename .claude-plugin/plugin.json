{
  "name": "oh-my-gx",
  "description": "요구사항 분석, 구현, 코드 리뷰와 검증을 지원하는 개발 워크플로.",
  "version": "2.0.2",
  "author": {
    "name": "bs-koo"
  },
  "homepage": "https://bs-koo.github.io/oh-my-gx/",
  "repository": "https://github.com/bs-koo/oh-my-gx",
  "keywords": [
    "java",
    "spring-boot",
    "vue",
    "fullstack",
    "korean",
    "dev-workflow",
    "prd",
    "code-review",
    "ai-workflow",
    "tdd",
    "domain-context"
  ],
  "skills": "./.claude/skills/",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre-tool-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/.claude/hooks/capture-decision.sh"
          }
        ]
      }
    ]
  }
}
