{
  "name": "oh-my-gx",
  "description": "프로젝트 지식 관리, 요구사항 정의, 설계·구현·리뷰·검증과 PR 생성을 지원하는 개발 워크플로.",
  "version": "3.2.0",
  "author": {
    "name": "bs-koo"
  },
  "homepage": "https://bs-koo.github.io/oh-my-gx/",
  "repository": "https://github.com/bs-koo/oh-my-gx",
  "keywords": [
    "java",
    "spring-boot",
    "vue",
    "fullstack",
    "korean",
    "dev-workflow",
    "prd",
    "code-review",
    "ai-workflow",
    "tdd",
    "domain-context"
  ],
  "skills": "./.claude/skills/",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/.claude/hooks/pre-tool-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "bash ${CLAUDE_PLUGIN_ROOT}/.claude/hooks/capture-decision.sh"
          }
        ]
      }
    ]
  }
}
